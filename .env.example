# SmartDesk AI - Variáveis de Ambiente
# Obtenha estas credenciais no painel do seu projeto Supabase (Project Settings > API)

# URL do seu projeto Supabase (ex: https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=

# Chave pública anônima (anon key ou publishable key). 
# ATENÇÃO: NUNCA use a service_role key aqui!
VITE_SUPABASE_ANON_KEY=

# URL do formulário de abertura de chamados no n8n (opcional, mas recomendado)
# Exemplo: https://seu-workspace.app.n8n.cloud/form/...
VITE_N8N_FORM_URL=
